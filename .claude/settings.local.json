{
  "permissions": {
    "allow": [
      "Bash",
      "Bash(*)",
      "PowerShell",
      "PowerShell(*)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(echo *)",
      "Bash(git *)",
      "Bash(pwd)",
      "PowerShell($env:Path*)",
      "PowerShell(git *)",
      "Edit(/.claude/skills/requirements-quality/**)",
      "Edit(/.claude/skills/fmea/**)",
      "Edit(/.claude/skills/install-toolkit/**)",
      "Edit(/.claude/skills/execute-flow/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true
  }
}
